#include <iostream>
#include <vector>
#include <algorithm> 

using namespace std;

int main() {

    vector<double> temperatures = {85.5, -150.0, 90.0, 210.0, 78.5, -50.0, 95.0, 250.0};


    cout << "Исходные температуры ";
    for (size_t i = 0; i < temperatures.size(); i++) {
        cout << temperatures[i] << " ";
    }
    cout << "\nРазмер до очистки: " << temperatures.size() << endl;


    auto new_end = remove_if(temperatures.begin(), temperatures.end(), [](double t) {
        return (t < -100.0 || t > 200.0);
    });


    temperatures.erase(new_end, temperatures.end());


    cout << "\nОчищенные температуры: ";
    for (size_t i = 0; i < temperatures.size(); i++) {
        cout << temperatures[i] << " ";
    }
    cout << "\nРазмер после очистки: " << temperatures.size() << endl;

    return 0;
}
