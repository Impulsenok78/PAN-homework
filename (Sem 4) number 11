#include <iostream>
#include <iomanip>
using namespace std;

class Engine {
private:
    double thrust;
    double fuelFlow;
    double fuel;

public:
    Engine(double t, double ff, double f) {
        thrust = t;
        fuelFlow = ff;
        fuel = f;
    }

    double getThrust() {
        return thrust;
    }

    bool hasFuel() {
        return fuel > 0;
    }

    void burn(double dt) {
        if (hasFuel()) {
            fuel -= fuelFlow * dt;
            if (fuel < 0) fuel = 0;
        }
    }

    double getFuel() {
        return fuel;
    }
};

class Navigation {
private:
    double altitude;
    double velocity;
    double acceleration;
    double mass;

public:
    Navigation(double alt, double vel, double m) {
        altitude = alt;
        velocity = vel;
        mass = m;
        acceleration = 0;
    }

    void update(double thrust, double dt) {
        acceleration = thrust / mass - 9.81;
        velocity += acceleration * dt;
        altitude += velocity * dt;
    }

    void printStatus(double time) {
        cout << "t=" << fixed << setprecision(2) << time << "c | "
             << "h=" << altitude << "м | "
             << "v=" << velocity << "м/с | "
             << "a=" << acceleration << "м/с^2" << endl;
    }
};

class AutonomousFlightSystem {
private:
    Engine engine;
    Navigation nav;
    double time;

public:
    AutonomousFlightSystem(Engine e, Navigation n) : engine(e), nav(n) {
        time = 0;
    }

    void simulate(double dt, double totalTime) {
        while (time < totalTime && engine.hasFuel()) {
            engine.burn(dt);
            nav.update(engine.getThrust(), dt);
            nav.printStatus(time);
            time += dt;
        }
    }

    void printSummary() {
        cout << "--- Полет завершен ---" << endl;
        cout << "Оставшееся топливо: " << engine.getFuel() << " кг" << endl;
    }
};

int main() {
    Engine mainEngine(10000, 20, 50);
    Navigation mainNav(10, 10, 1500);
    
    AutonomousFlightSystem flightSystem(mainEngine, mainNav);
    
    flightSystem.simulate(1.0, 5.0);
    flightSystem.printSummary();

    return 0;
}
