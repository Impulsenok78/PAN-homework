#include <iostream>
#include <iomanip>
using namespace std;

class RocketStage {
private:
    double thrust;
    double burnTime;
    double mass;

public:
    RocketStage(double t, double bt, double m) {
        thrust = t;
        burnTime = bt;
        mass = m;
    }

    double getDeltaV() {
        return (thrust * burnTime) / mass;
    }

    void printInfo() {
        cout << "Тяга: " << thrust << " Н Время: " << burnTime 
             << " с  Масса: " << mass << " кг  dV: " << fixed << setprecision(2) 
             << getDeltaV() << " м/с" << endl;
    }
};

int main() {
    RocketStage s1(5000, 10, 1000);
    RocketStage s2(7000, 8, 900);
    RocketStage s3(9000, 6, 800);

    double totalV = s1.getDeltaV() + s2.getDeltaV() + s3.getDeltaV();
    
    cout << "Итоговая скорость ракеты: " << fixed << setprecision(2) << totalV << " м/с \n";

    return 0;
}
