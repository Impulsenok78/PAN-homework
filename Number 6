#include <iostream>
using namespace std;

int main() {
    int n;
    
    cout << "Размер массива: ";
    cin >> n;
    
    double V[n], p[n], L[n], S, C;
    
    cout << "Площадь S: ";
    cin >> S;
    
    cout << "Коэф подьемной силы C: ";
    cin >> C;

    cout << "Начинается цикл: ";
    for (int i = 0; i < n; i++){
        cout << "Скорость V" << i+1 << ": ";
        cin >> V[i];
        cout << "Плотность воздуха p" << i+1 << ": ";
        cin >> p[i];
    };
    
    for (int i = 0; i < n; i++){
        L[i] = 0.5 * p[i] * V[i] * V[i] * S * C;
    };
    cout <<""<< endl;
    cout << "|Шаг|\t|Скорость|\t|Плотность|\t|Подъемная сила|" << endl;

    for (int i = 0; i < n; i++){
        cout << i + 1 << "\t\t" << V[i] <<"\t\t\t" << p[i] << "\t\t\t" << L[i] << endl;
                    
    };
    return 0;
}
