#include <iostream>
#include <vector>
#include <iomanip> 
#include <algorithm>

using namespace std;

int main() {

    const double v0 = 50.0;
    const double g = 9.8;
    const double dt = 1.0;

    vector<double> times;
    vector<double> heights;

    int primerniy_size = (int)(v0 * 2 / g / dt);
    times.reserve(primerniy_size);
    heights.reserve(primerniy_size);


    for (double t = 0.0; ; t += dt) { 
        
        double h = v0 * t - 0.5 * g * t * t;
        if (h < 0 && t > 0.0) {
            break;
        }

        times.push_back(t);
        heights.push_back(h);
    }


    auto max_it = max_element(heights.begin(), heights.end());
    

    double max_h = *max_it; 
    

    size_t idx_max = distance(heights.begin(), max_it); 
    

    double t_max = times[idx_max]; 


    cout << "Максимальная высота: " << fixed << setprecision(2) << max_h << " м" << endl;
    cout << "Достигнута на секунде: " << fixed << setprecision(1) << t_max << " с" << endl;

    return 0;
}
