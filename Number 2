#include <iostream>
#include <vector>
#include <iomanip> 
#include <algorithm>

using namespace std;

int main() {
    const double v0 = 50.0;
    const double g = 9.8;
    const double dt = 1.0;

    if (v0 <= 0) {
        cout << "Предупреждение" << endl;
    }

    vector<double> times;
    vector<double> heights;

    int primerniy_size = (int)(v0 * 2 / g / dt);
    times.reserve(primerniy_size);
    heights.reserve(primerniy_size);

    for (double t = 0.0; ; t += dt) { 
        
        if (t > 1000.0) {
            break;
        }
        double h = v0 * t - 0.5 * g * t * t;

        if (h < 0) {
            break;
        }

        times.push_back(t);
        heights.push_back(h);
    }

    if (heights.empty()) {
        cout << "Данных нет" << endl;
        return 0;
    }


    size_t idx_max = 0;
    for (size_t i = 1; i < heights.size(); ++i) {
        if (heights[i] > heights[idx_max]) {
            idx_max = i;
        }
    }


    cout <<  "Время (с)        " << setw(15) << "Высота (м)        " << endl;

    for (size_t i = 0; i < times.size(); i++) {
        cout << "   "<< times[i] << "               " << heights[i] << endl;
    }



    cout << "Максимальная высота: " << heights[idx_max] << " м" << endl;
    cout << "Достигнута на секунде: " << times[idx_max] << " с" << endl;
    


    return 0;
}
