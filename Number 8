#include <iostream>
#include <vector>
#include <iomanip> 
#include <algorithm>

using namespace std;

int main() {
    const double g = 9.8;
    const double dt = 1.0;

    double v0_1 = 50.0;
    vector<double> times1, heights1;
    int size1 = (int)(v0_1 * 2 / g / dt) + 2;
    times1.reserve(size1);
    heights1.reserve(size1);

    for (double t = 0.0; ; t += dt) { 
        double h = v0_1 * t - 0.5 * g * t * t;
        times1.push_back(t);
        heights1.push_back(h);
        if (h <= 0.0 && t > 0.0) break;
    }


    auto max_it1 = max_element(heights1.begin(), heights1.end());
    double max1 = *max_it1;
    size_t idx_max1 = distance(heights1.begin(), max_it1);
    double t_max1 = times1[idx_max1];


    auto fall_it1 = find_if(heights1.begin() + 1, heights1.end(), [](double h) { return h <= 0.0; });
    double t_fall1 = -1.0;
    if (fall_it1 != heights1.end()) {
        t_fall1 = times1[distance(heights1.begin(), fall_it1)];
    }


    double v0_2 = 80.0;
    vector<double> times2, heights2;
    int size2 = (int)(v0_2 * 2 / g / dt) + 2;
    times2.reserve(size2);
    heights2.reserve(size2);

    for (double t = 0.0; ; t += dt) { 
        double h = v0_2 * t - 0.5 * g * t * t;
        times2.push_back(t);
        heights2.push_back(h);
        if (h <= 0.0 && t > 0.0) break;
    }

 
    auto max_it2 = max_element(heights2.begin(), heights2.end());
    double max2 = *max_it2;
    size_t idx_max2 = distance(heights2.begin(), max_it2);
    double t_max2 = times2[idx_max2];


    auto fall_it2 = find_if(heights2.begin() + 1, heights2.end(), [](double h) { return h <= 0.0; });
    double t_fall2 = -1.0;
    if (fall_it2 != heights2.end()) {
        t_fall2 = times2[distance(heights2.begin(), fall_it2)];
    }
    

    if (max1 > max2) {
        cout << "Ракета 1 поднялась выше" << endl;
    } else if (max2 > max1) {
        cout << "Ракета 2 поднялась выше" << endl;
    } else {
        cout << "Обе ракеты поднялись на одинаковую высоту" << endl;
    }


    if (t_fall1 == -1.0 && t_fall2 == -1.0) {
        cout << "Обе ракеты все еще в воздухе" << endl;
    } else if (t_fall1 == -1.0) {
        cout << "Ракета 1 все еще в воздухе (дольше)" << endl;
    } else if (t_fall2 == -1.0) {
        cout << "Ракета 2 все еще в воздухе (дольше)" << endl;
    } else if (t_fall1 > t_fall2) {
        cout << "Ракета 1 находилась в воздухе дольше" << endl;
    } else if (t_fall2 > t_fall1) {
        cout << "Ракета 2 находилась в воздухе дольше" << endl;
    } else {
        cout << "Обе ракеты были в воздухе одинаковое время." << endl;
    }



    cout << setw(20) << "Параметр" << setw(15) << "Ракета 1" << setw(15) << "Ракета 2" << endl;
 
    
    cout << setw(20) << "Макс. высота (м)" << setw(15) << fixed << setprecision(2) << max1 << setw(15) << max2 << endl;
    cout << setw(20) << "Время макс. (с)" << setw(15) << fixed << setprecision(1) << t_max1 << setw(15) << t_max2 << endl;
    
    cout << setw(20) << "Время падения (с)";
    if (t_fall1 == -1.0) cout << setw(15) << "В воздухе"; else cout << setw(15) << fixed << setprecision(1) << t_fall1;
    if (t_fall2 == -1.0) cout << setw(15) << "В воздухе"; else cout << setw(15) << fixed << setprecision(1) << t_fall2;
    cout << endl;

    return 0;
}
